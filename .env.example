# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne commitez jamais le fichier ".env" réel — seul ".env.example" doit être versionné.

# --- K-PAY (paiement) ---
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
# --- Serveur ---
PORT=3000

# --- Base de données PostgreSQL ---
# Utilisée avec docker-compose (nom du service "postgres" comme host) :
PGHOST=postgres
PGPORT=5432
PGUSER=certifpass
PGPASSWORD=changez-ce-mot-de-passe
PGDATABASE=certifpass
# PGSSL=true            # à activer si votre hébergeur PostgreSQL exige SSL
#
# Alternative : une seule variable DATABASE_URL (utilisée en priorité si
# définie), pratique avec un PostgreSQL managé (Render, Railway, Supabase...) :
# DATABASE_URL=postgres://certifpass:changez-ce-mot-de-passe@postgres:5432/certifpass

# --- Notification e-mail immédiate (Gmail SMTP) ---
GMAIL_USER=sermoshop@gmail.com
GMAIL_APP_PASSWORD=
ADMIN_NOTIFY_EMAIL=sermoshop@gmail.com

# --- Notification WhatsApp immédiate (CallMeBot) ---
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=xxxxxxx
