# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne commitez JAMAIS le fichier ".env" réel — seul ".env.example" (avec des
# placeholders, pas de vraies valeurs) doit être versionné.

# --- SEBPAY (paiement) ---
SEBPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEBPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEBPAY_API_URL=https://newapi.sebpay.bj/api/v1/collections
SEBPAY_CALLBACK_URL=http://localhost:3000/webhooks/sebpay
SEBPAY_WEBHOOK_HEADER=X-SebPay-Signature
SEBPAY_WEBHOOK_ALGO=sha256
SEBPAY_FETCH_TIMEOUT_MS=15000
SEBPAY_OPERATOR=mtn
SEBPAY_COUNTRY=BJ
# Mettre à true pour simuler les paiements en local sans appeler SebPay
SEBPAY_MOCK=true

# --- Serveur ---
PORT=3000
# Domaine autorisé à appeler l'API (CORS). Utilisez votre vrai domaine en
# production, ex: https://certifpass.com — évitez "*" en production.
CORS_ORIGIN=*

# --- Notification e-mail immédiate (Gmail SMTP) ---
GMAIL_USER=votre-adresse@gmail.com
GMAIL_APP_PASSWORD=XXXXXXXXXXXXXXXX
ADMIN_NOTIFY_EMAIL=votre-adresse@gmail.com

# --- Notification WhatsApp immédiate (CallMeBot) ---
CALLMEBOT_PHONE=+237000000000
CALLMEBOT_APIKEY=xxxxxxxx
