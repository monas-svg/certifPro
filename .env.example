# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne commitez JAMAIS le fichier ".env" réel — seul ".env.example" (avec des
# placeholders, pas de vraies valeurs) doit être versionné.

# --- K-PAY (paiement) ---
KPAY_SECRET_KEY=kpay_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Serveur ---
PORT=3000
# Domaine autorisé à appeler l'API (CORS). Utilisez votre vrai domaine en
# production, ex: https://certifpass.com — évitez "*" en production.
CORS_ORIGIN=*

# --- Notification e-mail immédiate (Gmail SMTP) ---
GMAIL_USER=votre-adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ADMIN_NOTIFY_EMAIL=votre-adresse@gmail.com

# --- Notification WhatsApp immédiate (CallMeBot) ---
CALLMEBOT_PHONE=+237600000000
CALLMEBOT_APIKEY=xxxxxxx
